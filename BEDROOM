def load_and_scale(path, scale_factor=0.1):
    img = pygame.image.load(path).convert_alpha()
    new_size = (int(img.get_width() * scale_factor), int(img.get_height() * scale_factor))
    return pygame.transform.smoothscale(img, new_size)
