def handle_inside_menu_events(event):
    global inside_menu_active, slider_dragging, volume, game_state
    if event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE:
        inside_menu_active = False
    elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
        if resume_button_rect.collidepoint(event.pos):
            button_click.play()
            inside_menu_active = False
        elif restart_button_rect.collidepoint(event.pos):
            pygame.mouse.set_cursor(error_cursor)
        elif quit_button_rect.collidepoint(event.pos):
            button_click.play()
            inside_menu_active = False
            game_state = "game"
            play_background_music()
        knob_x = slider_x + int(volume * slider_width)
        if (event.pos[0] - knob_x) ** 2 + (event.pos[1] - (slider_y + slider_height // 2)) ** 2 <= knob_radius ** 2:
            slider_dragging = True
    elif event.type == pygame.MOUSEBUTTONUP and event.button == 1:
        slider_dragging = False
    elif event.type == pygame.MOUSEMOTION and slider_dragging:
        mouse_x, _ = event.pos
        volume = max(0, min(1, (mouse_x - slider_x) / slider_width))
        pygame.mixer.music.set_volume(volume)

def draw_inside_menu():
    screen.blit(inside_menu_image, (250, 50))
    pygame.draw.rect(screen, (0, 0, 0), (slider_x, slider_y, slider_width, slider_height))
    knob_x = slider_x + int(volume * slider_width)
    pygame.draw.circle(screen, (0, 0, 0), (knob_x, slider_y + slider_height // 2), knob_radius)
    if volume == 0:
        slash_symbol = slash_font.render("\\", True, (0, 0, 0))
        screen.blit(slash_symbol, (slider_x + slider_width - 248, slider_y - 45))

def draw_sleep_popup():
    popup_rect = pygame.Rect(150, 200, 700, 220)
    pygame.draw.rect(screen, (220, 220, 220), popup_rect)
    pygame.draw.rect(screen, (0, 0, 0), popup_rect, 3)
    lines = [
        " Find out your sleep routine in the bedroom.",
        " You can only sleep for a limited time.",
        " You will be woken up after 20 seconds.",
        " Press ENTER to close this message."
    ]
    for i, line in enumerate(lines):
        text_surf = xs_font.render(line, True, (0, 0, 0))
        screen.blit(text_surf, (popup_rect.x + 30, popup_rect.y + 30 + i * 40))

def draw_sleep_overlay():
    elapsed = (pygame.time.get_ticks() - sleep_start_time) / 1000
    remaining = max(0, sleep_duration - elapsed)
    overlay = pygame.Surface(screen.get_size(), pygame.SRCALPHA)
    overlay.fill((0, 0, 0, 150))
    screen.blit(overlay, (0, 0))
    text = m_font.render(f"{remaining:04.2f}", True, (0, 0, 0))
    box = text.get_rect(center=(512, 288)).inflate(100, 50)
    pygame.draw.rect(screen, (0, 255, 0), box)
    pygame.draw.rect(screen, (0, 0, 0), box, 2)
    screen.blit(text, text.get_rect(center=box.center))

def bedroom_screen():
    screen.blit(Bedroom_image, (0, 0))
    draw_stats()
    screen.blit(Menu_button, (720, 0))
    if inside_menu_active:
        draw_inside_menu()
    if show_sleep_popup:
        draw_sleep_popup()
    draw_floating_texts()
    if sleeping:
        draw_sleep_overlay()
    if already_slept_popup and pygame.time.get_ticks():
        message = "You can only sleep once per entry, GO AND WORK NOW!"
        text_surf = xs_font.render(message, True, (255, 0, 0))
        text_rect = text_surf.get_rect(center=(screen.get_width() // 2, screen.get_height() - 280))
        box_rect = text_rect.inflate(20, 20)
        pygame.draw.rect(screen, (255, 255, 255), box_rect)
        pygame.draw.rect(screen, (255, 0, 0), box_rect, 2)
        screen.blit(text_surf, text_rect)
    if interacted_items_popup and pygame.time.get_ticks():
        message = "You must have 4 routines before sleeping! Don't be dirty!"
        text_surf = xs_font.render(message, True, (255, 140, 0))  
        text_rect = text_surf.get_rect(center=(screen.get_width() // 2, screen.get_height() - 240))
        box_rect = text_rect.inflate(20, 20)
        pygame.draw.rect(screen, (255, 255, 255), box_rect)
        pygame.draw.rect(screen, (255, 140, 0), box_rect, 2)
        screen.blit(text_surf, text_rect)

# === Main Function ===
def run():
    global sleeping, game_state, show_sleep_popup, already_slept_popup, interacted_items_popup
    global slept_once, sleep_start_time, inside_menu_active, popup_timer, bedroom_objects_initialized, previous_game_state

    running = True
    while running:
        current_time = pygame.time.get_ticks()
        mouse_pos = pygame.mouse.get_pos()

        if game_state == "bedroom" and previous_game_state != "bedroom":
            reset_bedroom_objects()

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                return "quit"

            if inside_menu_active:
                handle_inside_menu_events(event)
                continue

            if sleeping:
                continue

            if show_sleep_popup or already_slept_popup or interacted_items_popup:
                if event.type == pygame.KEYDOWN and event.key in [pygame.K_RETURN, pygame.K_KP_ENTER]:
                    show_sleep_popup = False
                    already_slept_popup = False
                    interacted_items_popup = False
                continue

            if game_state != "bedroom":
                running = False
                return

            if game_state == "bedroom":
                if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    if menu_button_rect.collidepoint(event.pos):
                        button_click.play()
                        inside_menu_active = True

                    elif brush_rect.collidepoint(event.pos):
                        correct_click.play()
                        interacted_items.add("brush")
                        add_floating_text("Brushed teeth!", event.pos[0], event.pos[1], (0, 100, 255))  # Blue

                    elif towel_rect.collidepoint(event.pos):
                        correct_click.play()
                        interacted_items.add("towel")
                        add_floating_text("Wiped face!", event.pos[0], event.pos[1], (0, 180, 0))  # Green

                    elif mirror_rect.collidepoint(event.pos):
                        correct_click.play()
                        interacted_items.add("mirror")
                        add_floating_text("Pretty!", event.pos[0], event.pos[1], (255, 105, 180))  # Pink

                    elif bed_rect.collidepoint(event.pos) and not sleeping:
                        if slept_once:
                            already_slept_popup = True
                            popup_timer = current_time
                            error_click.play() 
                        elif {"brush", "towel", "mirror"}.issubset(interacted_items):
                            correct_click.play()
                            sleeping = True
                            sleep_start_time = current_time
                            slept_once = True
                            play_sleep_start()
                        else:
                            interacted_items_popup = True
                            popup_timer = current_time
                            error_click.play() 

        if not inside_menu_active:
            if any(r.collidepoint(mouse_pos) for r in [brush_rect, towel_rect, mirror_rect, bed_rect]):
                pygame.mouse.set_cursor(bed_cursor)
            else:
                pygame.mouse.set_cursor(default_cursor)

        if sleeping:
            elapsed = (current_time - sleep_start_time) / 1000
            if elapsed >= sleep_duration:
                Functions.update_stats(hpchange=30)
                energy_increase.play()
                add_floating_text("+30 Energy", 200, 28, (128, 128, 128))
                sleeping = False
                interacted_items.clear()
                play_bedroom_music()

        if game_state == "bedroom":
            bedroom_screen()

        previous_game_state = game_state
        pygame.display.flip()
        clock.tick(FPS)
