class AdelineNPC:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.direction = random.choice(["left", "right"])
        self.walk_frame = 0
        self.walk_timer = 0
        self.walk_delay = 200  # 毫秒
        self.talking = False
        self.active = True
        self.dialogue_state = 0  # 0:初始, 1:选择颜色, 2:结果
        self.reward_given = False
        
    def update(self):
        if not self.active or self.talking:
            return
            
        # 限制在y坐标范围内
        if self.y < 190:
            self.y = 190
            self.direction = "right"
        elif self.y > 200:
            self.y = 200
            self.direction = "left"

        # 限制在x坐标范围内
        if self.x < -5:
            self.x = -5
            self.direction = "right"
        elif self.x > 1020:
            self.x = 1020
            self.direction = "left"

        # 随机改变方向
        if random.random() < 0.01:  # 1%的几率改变方向
            self.direction = "left" if self.direction == "right" else "right"
            
        # 移动
        if self.direction == "left":
            self.x -= 1
        else:
            self.x += 1
            
        # 更新动画帧
        if pygame.time.get_ticks() - self.walk_timer > self.walk_delay:
            self.walk_frame = (self.walk_frame + 1) % 2
            self.walk_timer = pygame.time.get_ticks()
    
    def draw(self, surface, camera_x, camera_y):
        if not self.active:
            return
            
        # 绘制NPC
        if self.direction == "left":
            img = npc_left1 if self.walk_frame == 0 else npc_left2
        else:
            img = npc_right1 if self.walk_frame == 0 else npc_right2
            
        surface.blit(img, (self.x - camera_x, self.y - camera_y))
        
        # 如果玩家靠近且不在对话中，显示提示
        if self.is_player_near() and not self.talking:
            text = FONT.render("Click Y to talk with ADELINE", True, WHITE)
            surface.blit(text, (self.x - camera_x - text.get_width()//2, self.y - camera_y - 30))
    
    def is_player_near(self):
        distance = ((self.x - player_x)**2 + (self.y - player_y)**2)**0.5
        return distance < 100
    
    def start_dialogue(self):
        self.talking = True
        self.dialogue_state = 0
    
    def end_dialogue(self):
        print("Dialogue ended.")
        self.talking = False
        if self.dialogue_state == 2:  # 如果完成了对话
            self.active = False  # NPC消失
        if selected_color_option != 0:
            self.active = False    

