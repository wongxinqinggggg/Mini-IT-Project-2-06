class FourDNPC:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.direction = random.choice(["left", "right"])
        self.walk_frame = 0
        self.walk_timer = 0
        self.walk_delay = 200
        self.talking = False
        self.active = True
        self.dialogue_state = 0  # 0:初始, 1:查看余额&下单, 2:Reward Display, 3:余额不足, 4:Bye, 5:有钱再来
        self.reward_money = 0
        self.reward_energy = 0
        self.selected_pay_option = 0
        self.dialogue_lines = [
            "Spend RM30 to buy a lottery ticket and receive a random reward",
            "Checking your wallet... Pls wait 3 seconds...",
            "Congratulations! Here's your reward:",
            "Sorry, you are too poor! Come to me when you have RM30",
            "See you next time...",
            "Come back anytime!"
        ]
        self.current_line = 0
        self.checked_wallet = False
        self.wallet_check_timer = 0
        self.wallet_check_duration = 3000  # 3秒
        self.wallet_check_started = False

    def handle_input(self, event):
        
        if event.type == pygame.KEYDOWN and self.talking:
            if self.dialogue_state == 0:  # 选择BUY/BYE状态
                if event.key == pygame.K_LEFT:
                    self.selected_pay_option = 0  # 选择BUY
                elif event.key == pygame.K_RIGHT:
                    self.selected_pay_option = 1  # 选择BYE
                elif event.key == pygame.K_RETURN:  # 确认选择
                    if self.selected_pay_option == 0:  # BUY
                        self.dialogue_state = 1  # 进入检查钱包状态
                        self.current_line = 1
                        self.checked_wallet = False
                        self.wallet_check_started = True
                        self.wallet_check_timer = pygame.time.get_ticks()
                    else:  # BYE
                        self.dialogue_state = 4
                        self.current_line = 4
                            
            elif event.key == pygame.K_SPACE:
                if self.dialogue_state == 2:      # 如果是奖励状态
                    Functions.update_stats (mpchange=self.reward_money, hpchange=self.reward_energy)   
                    self.dialogue_state = 5
                    self.current_line = 5
                elif self.dialogue_state in [3, 4, 5]:  # 钱不够/再见状态
                    self.end_dialogue()

    def update(self):
        global VM2

        if not self.active:
            return
            
        if self.y < 700:
            self.y = 700
            self.direction = "right"
        elif self.y > 800:
            self.y = 800
            self.direction = "left"

        if self.x < -5:
            self.x = -5
            self.direction = "right"
        elif self.x > 1000:
            self.x = 1000
            self.direction = "left"

        if random.random() < 0.01:
            self.direction = "left" if self.direction == "right" else "right"
            
        if self.direction == "left":
            self.x -= 1
        else:
            self.x += 1
            
        if pygame.time.get_ticks() - self.walk_timer > self.walk_delay:
            self.walk_frame = (self.walk_frame + 1) % 3
            self.walk_timer = pygame.time.get_ticks()

        # 只在对话状态下检查钱包状态
        if self.talking and self.dialogue_state == 1 and self.wallet_check_started and not self.checked_wallet:
            current_time = pygame.time.get_ticks()
            print(f"Checking wallet... Time elapsed: {current_time - self.wallet_check_timer}ms")  # 调试输出
            if current_time - self.wallet_check_timer >= self.wallet_check_duration:
                self.checked_wallet = True
                self.wallet_check_started = False
                print(f"Current VM2 value: {VM2}")

                if VM2 >= 30:
                    Functions.update_stats (+0, -30)
                    self.reward_money = random.choice([0,5,10,15,20,25,30,35,40,45,50,55,60,65,70,75,80])
                    self.reward_energy = random.choice([0,5,10,15,20,25,30,35,40,45,50,55,60,65,70,75,80])
                    self.dialogue_state = 2
                    self.current_line = 2
                else:
                    self.dialogue_state = 3
                    self.current_line = 3
                
    def draw(self, surface, camera_x, camera_y):
        if not self.active:
            return
       
        if self.talking:
            pygame.draw.rect(surface, (0, 0, 0), (50, HEIGHT-200, WIDTH-100, 150))
            pygame.draw.rect(surface, WHITE, (50, HEIGHT-200, WIDTH-100, 150), 3)
            
            if self.dialogue_state == 0:  # 初始选择状态
                
                for i, option in enumerate(["BUY", "BYE"]):
                    color = HIGHLIGHT if i == self.selected_pay_option else WHITE
                    surface.blit(font.render(option, True, color), (100+i*200, HEIGHT-140))

            elif self.dialogue_state == 1:
                surface.blit(small_font.render("Checking your wallet...", True, WHITE), (70, HEIGHT-180))

            elif self.dialogue_state == 2:
                screen.blit(four_d_img, (WIDTH//2 - four_d_img.get_width()//2, HEIGHT//2 - four_d_img.get_height()//2))
                reward_text = f"Reward: Money +{self.reward_money}, Energy +{self.reward_energy}"
                surface.blit(font.render(reward_text, True, WHITE), (WIDTH//2-442, HEIGHT//2+four_d_img.get_height()//2+60))
                surface.blit(small_font.render("Press SPACE to collect", True, WHITE), (70, HEIGHT-90))

            elif self.dialogue_state == 3:
                surface.blit(small_font.render("Sorry, you are too poor! Come to me when you have RM30", True, WHITE), (70, HEIGHT-180))

            elif self.dialogue_state == 4:
                surface.blit(small_font.render("See you next time...", True, WHITE), (70, HEIGHT-180))

            elif self.dialogue_state == 5:
                surface.blit(small_font.render("Come back anytime!", True, WHITE), (70, HEIGHT-180))

        # Draw NPC
        if self.direction == "left":
            if self.walk_frame == 0 or self.walk_frame == 2:
                img = npc_4d_img
            else:
                img = npc_4d_left1
        else:
            if self.walk_frame == 0 or self.walk_frame == 2:
                img = npc_4d_img
            else:
                img = npc_4d_right1
            
        surface.blit(img, (self.x - camera_x, self.y - camera_y))

        if self.is_player_near() and not self.talking:
            text = FONT.render("Click Y to talk with 4D Seller", True, WHITE)
            surface.blit(text, (self.x - camera_x - text.get_width()//2, self.y - camera_y - 30))
    
    def is_player_near(self):
        distance = ((self.x - player_x)**2 + (self.y - player_y)**2)**0.5
        return distance < 100

    def start_dialogue(self):
        self.talking = True
        self.dialogue_state = 0
        self.current_line = 0
        self.selected_pay_option = 0  # 重置选择
        self.reward_given = False  # 标记是否已给奖励
    
    def end_dialogue(self):
        self.talking = False
        self.dialogue_state = 0
        self.current_line = 0
        self.selected_pay_option = 0
        self.reward_given = False
        self.checked_wallet = False    

class PetNPC:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.direction = "right"
        self.walk_frame = 0
        self.walk_timer = 0
        self.walk_delay = 200
        self.follow_speed = 3
        self.follow_distance = 20
        self.talking = False
        self.active = True
        self.dialogue_state = 0
        self.selected_option = 0
        self.pet_name = ""
        self.name_input_active = False
        self.name_confirmed = False
        self.width = 32
        self.height = 32
        self.pet_img1 = pygame.image.load("Assets/Sprites/npc/pet1.png").convert_alpha()  # 右站立/右走1
        self.pet_img2 = pygame.image.load("Assets/Sprites/npc/pet1.png").convert_alpha()  # 右走2
        self.pet_img3 = pygame.image.load("Assets/Sprites/npc/pet1.png").convert_alpha()  # 左站立/左走1
        self.pet_img4 = pygame.image.load("Assets/Sprites/npc/pet1.png").convert_alpha()  # 左走2
        
    def update(self, player_x, player_y, collision_rects):
        if not self.name_confirmed:
            return
            
        # 计算与玩家的方向和距离
        dx = player_x - self.x
        dy = player_y - self.y
        
        # 确定移动方向
        if dx > 0:
            self.direction = "right"
        elif dx < 0:
            self.direction = "left"
        
        # 计算目标位置
        target_x = player_x - (self.follow_distance if self.direction == "right" else -self.follow_distance)
        target_y = player_y
        
        # 计算移动向量
        move_x = target_x - self.x
        move_y = target_y - self.y
        distance = (move_x**2 + move_y**2)**0.5
        
        if distance > 5:  # 需要移动
            # 标准化移动向量
            if distance > 0:
                move_x = move_x / distance * self.follow_speed
                move_y = move_y / distance * self.follow_speed
            
            # 先尝试x方向移动
            new_x = self.x + move_x
            new_y = self.y
            pet_rect = pygame.Rect(new_x, new_y, self.width, self.height)
            
            # 检查x方向碰撞
            can_move_x = True
            for rect in collision_rects:
                if pet_rect.colliderect(rect):
                    can_move_x = False
                    break
            
            if can_move_x:
                self.x = new_x
            else:
                move_x = 0
            
            # 再尝试y方向移动
            new_x = self.x
            new_y = self.y + move_y
            pet_rect = pygame.Rect(new_x, new_y, self.width, self.height)
            
            # 检查y方向碰撞
            can_move_y = True
            for rect in collision_rects:
                if pet_rect.colliderect(rect):
                    can_move_y = False
                    break
            
            if can_move_y:
                self.y = new_y
            
            # 更新动画帧（修改为4帧循环）
            if pygame.time.get_ticks() - self.walk_timer > self.walk_delay:
                self.walk_frame = (self.walk_frame + 1) % 4  # 现在有4帧
                self.walk_timer = pygame.time.get_ticks()
        else:
            self.walk_frame = 0  # 站立不动时使用第一帧

    def draw(self, surface, camera_x, camera_y):
        if not self.active:
            return
            
        # 绘制宠物 - 修改为4帧动画
        if self.direction == "left":
            # 向左走: pet3, pet4, pet3, pet4
            if self.walk_frame == 0 or self.walk_frame == 2:
                img = self.pet_img3
            else:
                img = self.pet_img4
        else:
            # 向右走: pet1, pet2, pet1, pet2
            if self.walk_frame == 0 or self.walk_frame == 2:
                img = self.pet_img1
            else:
                img = self.pet_img2
            
        surface.blit(img, (self.x - camera_x, self.y - camera_y))
        
        # 如果玩家靠近且不在对话中，显示提示
        if self.is_player_near() and not self.talking and not self.name_confirmed:
            text = FONT.render("Press P to talk with PET", True, WHITE)
            surface.blit(text, (self.x - camera_x - text.get_width()//2, self.y - camera_y - 30))
                
    def is_player_near(self):
        distance = ((self.x - player_x)**2 + (self.y - player_y)**2)**0.5
        return distance < 100
    
    def start_dialogue(self):
        if not self.name_confirmed:  # 只有在未确认名字时才开启对话
            self.talking = True
            self.dialogue_state = 0
    
    def handle_input(self, event):
        if event.type == pygame.KEYDOWN and self.talking:
            if self.dialogue_state == 0:  # 初始选择是否收养
                if event.key == pygame.K_LEFT:
                    self.selected_option = 0  # 选择YES
                elif event.key == pygame.K_RIGHT:
                    self.selected_option = 1  # 选择NO
                elif event.key == pygame.K_RETURN:
                    if self.selected_option == 0:  # YES
                        self.dialogue_state = 1  # 进入取名状态
                        self.name_input_active = True
                    else:  # NO
                        self.end_dialogue()
                        
            elif self.dialogue_state == 1:  # 取名状态
                if event.key == pygame.K_BACKSPACE:
                    self.pet_name = self.pet_name[:-1]
                elif event.key == pygame.K_RETURN and self.pet_name:  # 确认名字
                    self.name_input_active = False
                    self.dialogue_state = 2  # 进入确认名字状态
                elif len(self.pet_name) < 15 and event.unicode.isprintable():
                    self.pet_name += event.unicode
                    
            elif self.dialogue_state == 2:  # 确认名字
                if event.key == pygame.K_LEFT:
                    self.selected_option = 0  # 确认名字
                elif event.key == pygame.K_RIGHT:
                    self.selected_option = 1  # 重新命名
                elif event.key == pygame.K_RETURN:
                    if self.selected_option == 0:  # 确认
                        self.name_confirmed = True
                        self.end_dialogue()
                    else:  # 重新命名
                        self.dialogue_state = 0
                        self.pet_name = ""
    
    def end_dialogue(self):
        self.talking = False
        self.name_input_active = False
        if not self.name_confirmed:
            self.dialogue_state = 0

